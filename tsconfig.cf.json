{
  // Type-checks test/cloudflare/compat against @cloudflare/workers-types (globals replace DOM/Bun),
  // proving MiuJS's hand-written binding interfaces accept real Cloudflare bindings.
  // Run: bun run typecheck:cf
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "files": ["test/cloudflare/compat/compat.ts"]
}
