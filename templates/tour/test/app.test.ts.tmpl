test("admins get the back-office; creators do not", async () => {
  const admin = await form("/login", { email: "admin@example.com", password: ADMIN_PASSWORD });
  expect(admin.status).toBe(303);
  const list = await app.request("/admin/api/tours", { headers: { cookie: cookieOf(admin) } });
  expect(list.status).toBe(200);
  expect(((await list.json()) as { total: number }).total).toBeGreaterThan(0);

  const creator = await form("/login", { email: "maya@example.com", password: "s3cret-pass" });
  expect((await app.request("/admin/api/tours", { headers: { cookie: cookieOf(creator) } })).status).toBe(403);
});
