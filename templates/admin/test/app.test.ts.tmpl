import { afterAll, expect, test } from "bun:test";
import { mkdtempSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { createApp } from "../src/app.ts";

const dataDir = mkdtempSync(join(tmpdir(), "admin-test-"));
afterAll(() => rmSync(dataDir, { recursive: true, force: true }));

const EMAIL = "admin@example.com";
const PASSWORD = "correct horse battery staple";
const app = await createApp({ dataDir, adminEmail: EMAIL, adminPassword: PASSWORD, apiToken: "test-token-0123456789", logs: false });

/** Sign in through the login form; returns the session cookie. */
async function signIn(password: string) {
  const res = await app.request("/login", { method: "POST", body: new URLSearchParams({ email: EMAIL, password }) });
  return { res, cookie: res.headers.get("set-cookie")?.split(";")[0] ?? "" };
}

test("the admin redirects to the login page when signed out", async () => {
  const res = await app.request("/admin", { headers: { accept: "text/html" } });
  expect(res.status).toBe(302);
  expect(res.headers.get("location")).toStartWith("/login");
  expect((await app.request("/admin/api/posts")).status).toBe(401);
});

test("a wrong password is refused", async () => {
  const { res } = await signIn("nope");
  expect(res.headers.get("location")).toContain("error=1");
});

test("an admin signs in and creates an author and a post", async () => {
  const { res, cookie } = await signIn(PASSWORD);
  expect(res.status).toBe(303);
  expect(res.headers.get("location")).toBe("/admin");

  // Cookie-authenticated writes need the CSRF token from the admin API.
  const { token } = (await (await app.request("/admin/api/_csrf", { headers: { cookie } })).json()) as { token: string };
  const call = (method: string, path: string, body?: unknown) =>
    app.request(path, {
      method,
      headers: { cookie, "x-csrf-token": token, "content-type": "application/json" },
      body: body === undefined ? undefined : JSON.stringify(body),
    });

  const author = await call("POST", "/admin/api/authors", { name: "Ada Lovelace" });
  expect(author.status).toBe(201);
  const { id: authorId } = (await author.json()) as { id: string };

  const post = await call("POST", "/admin/api/posts", { title: "Hello, world", authorId });
  expect(post.status).toBe(201);
  expect(await post.json()).toMatchObject({ title: "Hello, world", status: "draft", authorId });

  const list = (await (await call("GET", "/admin/api/posts")).json()) as { total: number };
  expect(list.total).toBe(1);
});

test("agents get the same actions as MCP tools", async () => {
  const res = await app.request("/mcp", {
    method: "POST",
    headers: { authorization: "Bearer test-token-0123456789", "content-type": "application/json" },
    body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "tools/list" }),
  });
  const names = ((await res.json()) as { result: { tools: { name: string }[] } }).result.tools.map((t) => t.name);
  expect(names).toContain("admin_create_posts");
  expect(names).toContain("admin_list_authors");
});
