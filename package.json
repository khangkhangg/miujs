{
  "name": "miujs",
  "version": "0.3.0",
  "description": "Fast, secure, runs anywhere (Bun, Node, Cloudflare Workers), and every route is automatically an agent tool.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "khangkhangg",
  "repository": {
    "type": "git",
    "url": "https://github.com/khangkhangg/miujs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "miu": "./dist/bin/miu.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "bun": "./src/client/index.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./cloudflare": {
      "types": "./dist/adapters/cloudflare/index.d.ts",
      "bun": "./src/adapters/cloudflare/index.ts",
      "import": "./dist/adapters/cloudflare/index.js",
      "default": "./dist/adapters/cloudflare/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate/index.d.ts",
      "bun": "./src/migrate/index.ts",
      "import": "./dist/migrate/index.js",
      "default": "./dist/migrate/index.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "bun": "./src/adapters/node.ts",
      "import": "./dist/adapters/node.js",
      "default": "./dist/adapters/node.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "bun": "./src/realtime/index.ts",
      "import": "./dist/realtime/index.js",
      "default": "./dist/realtime/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "bun": "./src/sqlite.ts",
      "import": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    }
  },
  "files": [
    "dist",
    "src",
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "dev": "bun --watch examples/basic.ts",
    "bench": "cd bench && bun run.ts",
    "bench:micro": "cd bench && bun micro.ts",
    "build": "bun scripts/build.ts",
    "typecheck:cf": "tsc -p tsconfig.cf.json",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "framework",
    "bun",
    "cloudflare-workers",
    "mcp",
    "openapi",
    "ai",
    "agents"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
